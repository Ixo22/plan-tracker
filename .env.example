# Copy this file to .env and fill in your values.
# Never commit the real .env file to the repository.

# PostgreSQL connection string (Supabase / Neon / Vercel Postgres)
DATABASE_URL=""

# Secret key for NextAuth.js session encryption
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Base URL of your deployment (used by NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"

# Secret token used to authorize Vercel Cron Jobs in production
# Generate one with: openssl rand -hex 32
CRON_SECRET=""

# Resend API key for email notifications (https://resend.com)
RESEND_API_KEY=""

# Email address that will receive the daily level alerts
NOTIFICATION_EMAIL=""
